# ── Course Tutor configuration ───────────────────────────────────────────────
# LLM provider: ollama | github | openai | compatible
LLM_PROVIDER=ollama

# Ollama (local, free)
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# GitHub Models (free with a GitHub account) — token from github.com/settings/tokens
#GITHUB_TOKEN=
#GITHUB_MODEL=gpt-4o-mini

# OpenAI (paid)
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint (LM Studio, vLLM, Groq, OpenRouter…)
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_MODEL=
#LLM_API_KEY=

# Retrieval — defaults chosen by benchmark_embeddings.py (see BENCHMARK_RESULTS.md)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODE=dense
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_TEMPERATURE=0.2
