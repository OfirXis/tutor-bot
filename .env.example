# ── Course Tutor configuration ───────────────────────────────────────────────
# LLM provider: ollama | github | openai | compatible
LLM_PROVIDER=ollama

# Ollama (local, free)
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# GitHub Models (free with a GitHub account) — token from github.com/settings/tokens
# NOTE: GitHub Models API is being retired (410 brownouts as of Aug 2026) — prefer ollama/openai
#GITHUB_TOKEN=
#GITHUB_MODEL=openai/gpt-4o-mini

# OpenAI (paid)
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# Hebrew support: questions/answers are auto-detected and translated at the
# retrieval/LLM boundary (course material + embeddings are English-only).
# Translation uses OpenAI (TRANSLATION_MODEL, default gpt-4o-mini) whenever
# OPENAI_API_KEY is set above, regardless of LLM_PROVIDER — free local 3B
# models were tested and produce unreliable Hebrew CS terminology. Without a
# key, translation silently falls back to whichever LLM_PROVIDER is active.
#TRANSLATION_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint (LM Studio, vLLM, Groq, OpenRouter…)
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_MODEL=
#LLM_API_KEY=

# Retrieval — defaults chosen by benchmark_embeddings.py (see BENCHMARK_RESULTS.md)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODE=dense
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_TEMPERATURE=0.2
