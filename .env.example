# ── Course Tutor configuration ───────────────────────────────────────────────
# LLM provider: ollama | github | openai | openrouter | compatible
LLM_PROVIDER=ollama

# Ollama (local, free)
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# GitHub Models (free with a GitHub account) — token from github.com/settings/tokens
# NOTE: GitHub Models API is being retired (410 brownouts as of Aug 2026) — prefer ollama/openai
#GITHUB_TOKEN=
#GITHUB_MODEL=openai/gpt-4o-mini

# OpenAI (paid)
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# OpenRouter (paid) — key from openrouter.ai/keys. For the whole pipeline on one
# key, set LLM_PROVIDER=openrouter and TRANSLATION_PROVIDER=openrouter.
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=anthropic/claude-haiku-5.5
#TRANSLATION_OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Hebrew support: questions/answers are auto-detected and translated at the
# retrieval/LLM boundary (course material + embeddings are English-only).
# Independent translator: auto | ollama | tutor | openai | openrouter
# auto: OpenAI when a key exists, otherwise selected tutoring model.
# ollama: dedicated local translator; never silently falls back to a paid provider.
TRANSLATION_PROVIDER=auto
# Set ollama above after installing/importing a Hebrew-capable model:
#TRANSLATION_OLLAMA_MODEL=dictalm-translator
#TRANSLATION_OLLAMA_BASE_URL=http://localhost:11434
#TRANSLATION_NUM_CTX=4096
#TRANSLATION_MAX_TOKENS=768
#TRANSLATION_TIMEOUT_SECONDS=45
#TRANSLATION_KEEP_ALIVE=10m
#TRANSLATION_MODEL=gpt-4o-mini
#UI_LANGUAGE=en

# Any OpenAI-compatible endpoint (LM Studio, vLLM, Groq, OpenRouter…)
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_MODEL=
#LLM_API_KEY=

# Retrieval — defaults chosen by benchmark_embeddings.py (see BENCHMARK_RESULTS.md)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODE=dense
# Cosine relevance floor; calibrate again if changing embedding models.
EVIDENCE_MIN_SIMILARITY=0.60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_TEMPERATURE=0.2
